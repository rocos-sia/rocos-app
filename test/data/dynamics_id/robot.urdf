<robot name="offline_identification_fixture">
<link name="base"/>
<link name="one"><inertial><origin xyz="0.2 0 0"/><mass value="1"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.04"/></inertial></link>
<link name="two"><inertial><origin xyz="0.3 0 0"/><mass value="0.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.03"/></inertial></link>
<joint name="joint_1" type="revolute"><parent link="base"/><child link="one"/><axis xyz="0 1 0"/><limit lower="-2" upper="2" velocity="3" effort="50"/></joint>
<joint name="joint_2" type="revolute"><parent link="one"/><child link="two"/><origin xyz="0.5 0 0"/><axis xyz="0 0 1"/><limit lower="-2" upper="2" velocity="3" effort="50"/></joint>
</robot>
